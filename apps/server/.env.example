# Copie para apps/server/.env (carregado automaticamente por `dev` e `start`).
# Token do bot: Discord Developer Portal > Applications > Bot > Reset Token
DISCORD_TOKEN=
# ID (snowflake) da guild única onde os slash commands são registrados
GUILD_ID=
# Postgres (dev: docker compose -f docker-compose.dev.yml up -d na raiz)
DATABASE_URL=postgres://albion:albion@localhost:5432/albion_hub
PORT=3000
NODE_ENV=development
# false sobe só a API (sem login no Discord)
DISCORD_BOT_ENABLED=true
# Cargo "Membro" dado na primeira aprovação de nick (obrigatório com o bot ligado).
# O cargo do bot precisa ficar ACIMA deste cargo, com Gerenciar Apelidos e Gerenciar Cargos.
DISCORD_MEMBER_ROLE_ID=

# --- Login do painel com Discord OAuth2 (TASK-008) ---
# Developer Portal > Applications > OAuth2: Client ID e Client Secret.
# Cadastre em OAuth2 > Redirects exatamente: <PUBLIC_URL>/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Origem pública do painel, sem barra final (https obrigatório com NODE_ENV=production)
PUBLIC_URL=http://localhost:3000
# Duração da sessão em dias (1 a 90)
SESSION_TTL_DAYS=30
# Opcional: IDs Discord (snowflakes, separados por vírgula) que viram admin ao logar
BOOTSTRAP_ADMIN_DISCORD_IDS=
