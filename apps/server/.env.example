# Copie para apps/server/.env (carregado automaticamente por `dev` e `start`).
# Token do bot: Discord Developer Portal > Applications > Bot > Reset Token
DISCORD_TOKEN=
# ID (snowflake) da guild única onde os slash commands são registrados
GUILD_ID=
# Postgres (dev: docker compose -f docker-compose.dev.yml up -d na raiz)
DATABASE_URL=postgres://albion:albion@localhost:5432/albion_hub
PORT=3000
NODE_ENV=development
# false sobe só a API (sem login no Discord)
DISCORD_BOT_ENABLED=true
# Cargo "Membro" dado na primeira aprovação de nick (obrigatório com o bot ligado).
# O cargo do bot precisa ficar ACIMA deste cargo, com Gerenciar Apelidos e Gerenciar Cargos.
DISCORD_MEMBER_ROLE_ID=
# Canal da staff para pedidos de nick com botões (TASK-015). Obrigatório com o bot ligado.
DISCORD_STAFF_CHANNEL_ID=
# Canal onde o bot publica o embed de inscrição dos eventos (TASK-022). Obrigatório com o bot ligado.
DISCORD_EVENTS_CHANNEL_ID=
# Canal de voz fixo "Aguardando Evento": o start do evento só arrasta quem estiver nele (TASK-024, Q29). Obrigatório com o bot ligado.
DISCORD_WAITING_VOICE_CHANNEL_ID=
# Categoria onde o canal de voz do evento é criado no start e apagado no finish (TASK-024, Q28). Obrigatório com o bot ligado.
DISCORD_EVENT_CATEGORY_ID=

# --- Login do painel com Discord OAuth2 (TASK-008) ---
# Developer Portal > Applications > OAuth2: Client ID e Client Secret.
# Cadastre em OAuth2 > Redirects exatamente: <PUBLIC_URL>/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Origem pública do painel, sem barra final (https obrigatório com NODE_ENV=production)
PUBLIC_URL=http://localhost:3000
# Duração da sessão em dias (1 a 90)
SESSION_TTL_DAYS=30
# Opcional: IDs Discord (snowflakes, separados por vírgula) que viram admin ao logar
BOOTSTRAP_ADMIN_DISCORD_IDS=

# --- Conferência de nick na API Albion (TASK-016) ---
# Opcional: americas, europe ou asia. Vazio desliga. Só ajuda a staff, nunca bloqueia registro nem aprovação.
ALBION_REGION=

# --- Namespace de manutenção (TASK-048, G5) ---
# Segredo do header x-maintenance-token das rotas /api/maintenance (ajuste de prata, revalidação de
# nick, disparo da limpeza). Vale em dev E em produção.
# VAZIO = namespace DESLIGADO: nenhuma rota é registrada. Não existe default nem fallback.
# Mínimo de 32 caracteres. Gere um valor aleatório (ex: `openssl rand -base64 48`) e NUNCA o escreva
# em commit, log, print ou issue. Se vazar, troque o valor e reinicie o servidor: é a única revogação.
MAINTENANCE_TOKEN=
