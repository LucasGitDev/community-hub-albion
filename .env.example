# Postgres local: docker compose -f docker-compose.dev.yml up -d
# Porta do host (se 5432 estiver ocupada, altere aqui e na URL abaixo)
POSTGRES_PORT=5432
DATABASE_URL=postgres://albion:albion@localhost:5432/albion_hub

# --- compose de produção (docker-compose.yml) ---
APP_PORT=3000
POSTGRES_USER=albion
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=albion_hub
DISCORD_TOKEN=
GUILD_ID=
DISCORD_BOT_ENABLED=true
# Cargo Membro (primeira aprovação de nick); obrigatório com o bot ligado
DISCORD_MEMBER_ROLE_ID=
# Canal da staff para pedidos de nick com botões (TASK-015). Obrigatório com o bot ligado.
DISCORD_STAFF_CHANNEL_ID=
# Canal onde o bot publica o embed de inscrição dos eventos (TASK-022). Obrigatório com o bot ligado.
DISCORD_EVENTS_CHANNEL_ID=
# Canal de voz fixo "Aguardando Evento": o start do evento só arrasta quem estiver nele (TASK-024, Q29). Obrigatório com o bot ligado.
DISCORD_WAITING_VOICE_CHANNEL_ID=
# Categoria onde o canal de voz do evento é criado no start e apagado no finish (TASK-024, Q28). Obrigatório com o bot ligado.
DISCORD_EVENT_CATEGORY_ID=
# Opcional: id do emoji da Buffunfa no servidor (TASK-056, F6-28). Vazio = o bot procura pelo nome
# "buffunfa" na guild e, se não achar, tenta criar a partir de assets/buffunfa_emoji_simples_128.png.
# Falha de permissão ou de slot vira aviso no log e a Buffunfa sai como texto (340 BUF). Nunca fixe o id
# no código: emoji é por servidor.
DISCORD_BUFFUNFA_EMOJI_ID=
# Login do painel (Discord OAuth2). Redirect no Developer Portal: <PUBLIC_URL>/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
PUBLIC_URL=https://painel.exemplo.com
SESSION_TTL_DAYS=30
BOOTSTRAP_ADMIN_DISCORD_IDS=
# Opcional: região do Albion pra conferir nick na API pública (americas, europe ou asia). Vazio desliga; nunca bloqueia.
ALBION_REGION=
