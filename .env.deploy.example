# Pipeline local (scripts/local-pipeline.mjs) — usado enquanto o GitHub Actions está sem saldo.
# Copie para `.env.deploy` (git-ignored) e preencha. São os mesmos nomes dos secrets do GitHub,
# de propósito: quando o saldo voltar, o workflow assume sem tradução.

# Usuário do Docker Hub (NÃO o e-mail) e token de acesso (Account Settings > Security).
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

# Opcional: nome da imagem. Sem isso, vira <DOCKERHUB_USERNAME>/albion-hub.
DOCKERHUB_IMAGE=

# Webhook de deploy do Easypanel. Sem ele a imagem sobe, mas o deploy não é disparado.
EASYPANEL_DEPLOY_WEBHOOK=
