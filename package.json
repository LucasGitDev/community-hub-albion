{
  "name": "albion-hub",
  "private": true,
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings 0",
    "test": "turbo run build --filter=./packages/* && vitest run",
    "coverage": "turbo run build --filter=./packages/* && vitest run --coverage",
    "e2e": "playwright test",
    "dup": "jscpd",
    "deadcode": "knip",
    "audit:prod": "pnpm audit --prod --audit-level=high",
    "quality": "node scripts/quality-gate.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jscpd": "^5.2.0",
    "knip": "^6.35.1",
    "turbo": "^2.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
